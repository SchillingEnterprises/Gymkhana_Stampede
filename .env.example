# Export these in your shell or deployment secret manager; this project does not auto-load .env.
DJANGO_SECRET_KEY=generate-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
GEOPOSITION_GOOGLE_MAPS_API_KEY=
GOOGLE_API_KEY=

# Production: use a new secret, real hostnames, HTTPS, secure cookies.
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=your-domain.example
# DJANGO_CSRF_TRUSTED_ORIGINS=your-domain.example
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# DJANGO_HSTS_SECONDS=31536000
