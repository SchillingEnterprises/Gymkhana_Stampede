# Export these values in your shell or deployment secret manager.
DJANGO_SECRET_KEY=generate-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_DB_ENGINE=sqlite
DJANGO_DATABASE_NAME=
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=webmaster@localhost

# PostgreSQL / Cloud SQL settings (required for persistent production data).
# DJANGO_DB_ENGINE=postgresql
# DJANGO_DB_NAME=gymkhana
# DJANGO_DB_USER=gymkhana_app
# DJANGO_DB_PASSWORD=load-from-secret-manager
# DJANGO_DB_HOST=/cloudsql/PROJECT:REGION:INSTANCE
# DJANGO_DB_PORT=5432

# Optional restricted browser mapping key.
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_API_KEY=

# Production HTTPS/proxy settings.
# DJANGO_DEBUG=false
# DJANGO_TRUST_PROXY=true
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# DJANGO_HSTS_SECONDS=31536000
